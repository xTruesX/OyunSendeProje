  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Yar\u0131 g\xF6m\xFCl\xFC bir kervanc\u0131 g\xFCnl\xFC\u011F\xFC:"
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "\"Erlik'in el\xE7ileri yery\xFCz\xFCnde alt\u0131n da\u011F\u0131tt\u0131; kar\u015F\u0131l\u0131\u011F\u0131nda yaln\u0131zca k\xFC\xE7\xFCk bir yalan istediler.\""
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "\"Kimse bedelin kendi ruhlar\u0131 oldu\u011Funu bilmiyordu.\""
    duration: 0
    setFlag: 
