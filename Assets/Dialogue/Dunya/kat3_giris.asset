  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: kat3_giris
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan yoluna devam etti ve \xFC\xE7\xFCnc\xFC kata ula\u015Ft\u0131: Hastal\u0131k ve \xC7\xFCr\xFCme Diyar\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Zemininde zehirli ye\u015Fil sisler, batakl\u0131klar ve havada u\xE7u\u015Fan salg\u0131n tozlar\u0131 vard\u0131. Nefes almak bile can yak\u0131yordu."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Buras\u0131, yery\xFCz\xFCne salg\u0131nlar\u0131 ve ac\u0131y\u0131 yayan \xC7al\u0131\u015F Han'\u0131n diyar\u0131yd\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Batakl\u0131klar insan\u0131 i\xE7ine \xE7eker, hava zehirler. Ye\u015Fil sislerden uzak dur."
    duration: 0
    setFlag: 
