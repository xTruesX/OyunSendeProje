  lines:
  - speaker: {fileID: 0}
    text: "Ve sonunda B\xF6r\xFChan son kata ula\u015Ft\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Erlik Han'\u0131n taht\u0131 ve \xDClgen Han'\u0131n tutuldu\u011Fu yer."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Yerler simsiyah, so\u011Fuk obsidyen ta\u015Flar\u0131yla kapl\u0131yd\u0131. \xC7evrede g\xF6\u011F\xFC ve yeri tuttu\u011Fu s\xF6ylenen, ama art\u0131k paslanm\u0131\u015F devasa demir s\xFCtunlar uzan\u0131yordu."
    duration: 0
    setFlag: 
