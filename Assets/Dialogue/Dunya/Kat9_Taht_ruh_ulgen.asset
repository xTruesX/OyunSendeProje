  lines:
  - speaker: {fileID: 11400000, guid: 3e7b2198f83b50c2cba876a3a693f5ed, type: 2}
    text: Evlat... Buraya kadar geldin.
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 3e7b2198f83b50c2cba876a3a693f5ed, type: 2}
    text: "Sesimi duyuyor musun? Korkma. Ben buraday\u0131m. Seni hep izledim."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 3e7b2198f83b50c2cba876a3a693f5ed, type: 2}
    text: "Erlik ill\xFCzyonlarla zihnini bunaltmaya \xE7al\u0131\u015Facak. Ger\xE7e\u011Fi hat\u0131rla: sen benim o\u011Flumsun."
    duration: 0
    setFlag: 
