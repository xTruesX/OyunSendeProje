  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: Kat9_Taht_taht
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Buras\u0131 s\u0131radan bir taht odas\u0131 de\u011Fildi."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Taht\u0131n arkas\u0131nda, B\xF6r\xFChan'\u0131n b\xFCt\xFCn bu yolu gelmesinin sebebi vard\u0131: \xDClgen Han."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 3e7b2198f83b50c2cba876a3a693f5ed, type: 2}
    text: "B\xF6r\xFChan... Evlat..."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Tahtta oturan ki\u015Fi Erlik Han'd\u0131. Aya\u011Fa kalkt\u0131 ve konu\u015Fmaya ba\u015Flad\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: ff8fb38869ed719d09620ced3e22bf5f, type: 2}
    text: "Demek b\xFCt\xFCn katlar\u0131 a\u015F\u0131p buraya kadar geldin ha?"
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: ff8fb38869ed719d09620ced3e22bf5f, type: 2}
    text: "\xDCzg\xFCn\xFCm ama buras\u0131 senin ula\u015Faca\u011F\u0131n son yer."
    duration: 0
    setFlag: 
