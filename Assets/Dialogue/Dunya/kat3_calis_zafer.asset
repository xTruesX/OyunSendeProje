    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Etraftaki zehirli gaz da\u011F\u0131ld\u0131. Geride ye\u015Fil bir \u0131\u015F\u0131kla parlayan bir \xF6z kald\u0131."
