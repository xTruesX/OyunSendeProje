  lines:
  - speaker: {fileID: 11400000, guid: 8b94b3c1adaddf071a195d1bfe91b2ff, type: 2}
    text: "Temir Han'\u0131n damarlar\u0131nda kan de\u011Fil, lav akar."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 8b94b3c1adaddf071a195d1bfe91b2ff, type: 2}
    text: "Bir darbesi da\u011Flar\u0131 yarar... Ama yava\u015Ft\u0131r, \xE7ok yava\u015F. Vuru\u015Funu bekle, sonra yan\u0131na ka\xE7."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 8b94b3c1adaddf071a195d1bfe91b2ff, type: 2}
    text: "Dengesini bozarsan, Kut'unla y\u0131k onu."
    duration: 0
    setFlag: 
