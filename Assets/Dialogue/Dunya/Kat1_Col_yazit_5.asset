  lines:
  - speaker: {fileID: 0}
    text: "\"Ayna her \u015Feyi g\xF6sterir, ama hi\xE7bir \u015Feyi bilmez.\""
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "\"Kendi yans\u0131manla kar\u015F\u0131la\u015Ft\u0131\u011F\u0131nda korkular\u0131n\u0131 de\u011Fil, sevdiklerini hat\u0131rla. Ve o parlad\u0131\u011F\u0131nda ona vurma.\""
