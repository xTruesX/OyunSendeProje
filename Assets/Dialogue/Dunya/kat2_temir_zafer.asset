  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: kat2_temir_zafer
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Dev par\xE7aland\u0131; i\xE7indeki lavlar etrafa akt\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Devin ellerinden biri metal bir eldivene d\xF6n\xFC\u015Ft\xFC. B\xF6r\xFChan eldiveni ald\u0131."
    duration: 0
    setFlag: demir_eldiven
  - speaker: {fileID: 0}
    text: "DEM\u0130R ELD\u0130VEN \u2014 A\u011F\u0131r sald\u0131r\u0131n art\u0131k d\xFC\u015Fman\u0131 sersemletir ve \xE7atlak duvarlar\u0131 k\u0131rar. Eldiven a\u011F\u0131rd\u0131r; sersemletme her an kullan\u0131lamaz."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan daha da g\xFC\xE7lendi\u011Fini hissetti, ama h\xE2l\xE2 haz\u0131r de\u011Fildi."
    duration: 0
    setFlag: 
