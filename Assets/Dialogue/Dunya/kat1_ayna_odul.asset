  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: kat1_ayna_odul
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan k\u0131l\u0131c\u0131n\u0131 tozlara saplayarak kal\u0131nt\u0131n\u0131n \xF6z\xFCn\xFC i\xE7ine ald\u0131."
    voice: {fileID: 8300000, guid: 790dbc3a5891302f0a3e44cf5fb7f2f1, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "AYNA SI\xC7RAMASI \u2014 Ka\xE7\u0131\u015F tu\u015Fu (Shift) art\u0131k seni k\u0131sa bir mesafe ileri \u0131\u015F\u0131nlar. Daha uza\u011Fa gitmez, ama \xE7ukurlar\u0131n \xFCzerinden ge\xE7ebilirsin."
    voice: {fileID: 8300000, guid: 6f7c615787e7d2176a2634cdc280b006, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Kumlar\u0131n ortas\u0131nda, a\u015Fa\u011F\u0131ya inen bir yar\u0131k a\xE7\u0131ld\u0131."
    voice: {fileID: 8300000, guid: 51765f77ce75737d0bd2ab2311d67899, type: 3}
    duration: 0
    setFlag: 
