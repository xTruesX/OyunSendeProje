  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: kat9_zafer
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Zorlu sava\u015F\u0131n sonunda Erlik Han yere y\u0131\u011F\u0131ld\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan pasl\u0131 zincirleri k\u0131l\u0131c\u0131yla par\xE7alad\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 3e7b2198f83b50c2cba876a3a693f5ed, type: 2}
    text: "Evlat... Gelece\u011Fini... biliyordum."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "\xDClgen Han'\u0131n hali bitmi\u015Fti; \xFCzeri yaral\u0131yd\u0131 ve \u0131\u015F\u0131\u011F\u0131 s\xF6nmek \xFCzereydi."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 1b85c12ef309323b2bffc83efae91dcb, type: 2}
    text: "Seni eve g\xF6t\xFCr\xFCyorum, baba."
    duration: 0
    setFlag: 
