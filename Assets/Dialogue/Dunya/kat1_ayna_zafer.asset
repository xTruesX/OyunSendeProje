    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Tozlar\u0131n aras\u0131nda parlayan bir \u015Fey kald\u0131."
    voice: {fileID: 8300000, guid: 6581b936d90ebe378897d012847c15b2, type: 3}
    duration: 0
