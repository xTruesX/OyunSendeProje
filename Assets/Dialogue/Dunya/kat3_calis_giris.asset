  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: kat3_calis_giris
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan batakl\u0131\u011F\u0131n sonunda \xC7al\u0131\u015F Han ile y\xFCzle\u015Fti."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 5f4d2cf17d0cbcc67b1ca3b6f19969b0, type: 2}
    text: "Nefes al, yi\u011Fit... Her nefes seni bana biraz daha yakla\u015Ft\u0131r\u0131r."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Etrafa zehirli gaz bulutlar\u0131 yay\u0131yor, batakl\u0131\u011F\u0131n derinliklerinden yeni yarat\u0131klar \xE7a\u011F\u0131r\u0131yordu."
    duration: 0
    setFlag: 
