  m_Name: kat3_calis_odul
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan \xC7al\u0131\u015F Han'\u0131n \xF6z\xFCn\xFC i\xE7ine ald\u0131 ve zehir ve veba ba\u011F\u0131\u015F\u0131kl\u0131\u011F\u0131 elde etti. Art\u0131k zehirler onu etkileyemezdi."
    voice: {fileID: 8300000, guid: 0b33b06ee658d19f59c0ea4b9ee8984f, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Ve yerin en dibine, son kata inen yol a\xE7\u0131ld\u0131."
    voice: {fileID: 8300000, guid: 01beb67a178f22ab79a0c82d631c006c, type: 3}
    duration: 0
    setFlag: 
