  lines:
  - speaker: {fileID: 11400000, guid: 230add4ab1e11c222994fbfce38d7ded, type: 2}
    text: "Ben karde\u015Fimi bir avu\xE7 alt\u0131n i\xE7in satt\u0131m..."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 230add4ab1e11c222994fbfce38d7ded, type: 2}
    text: "\u015Eimdi r\xFCzg\xE2r onun sesiyle bana f\u0131s\u0131ld\u0131yor. Her g\xFCn, her gece."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 230add4ab1e11c222994fbfce38d7ded, type: 2}
    text: "Sen kimseyi satma, yi\u011Fit. Kuzeydeki kervan yolunda, ihanetin g\xF6lgeleri pusuya yatar."
    duration: 0
    setFlag: 
