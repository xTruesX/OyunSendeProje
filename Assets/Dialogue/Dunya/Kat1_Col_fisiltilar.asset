  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: Kat1_Col_fisiltilar
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 11400000, guid: 84ebdd9607b946e368d16726ebe1701c, type: 2}
    text: "\xDClgen Han seni ger\xE7ekten evlad\u0131 olarak m\u0131 sevdi... yoksa seni kendi b\xFCy\xFCk plan\u0131 i\xE7in bir ara\xE7 m\u0131 yapt\u0131?"
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "F\u0131s\u0131lt\u0131lar B\xF6r\xFChan'\u0131n g\xFCvenini i\xE7eriden kemirmeye, zehirli bir sarma\u015F\u0131k gibi ruhunu sarmaya \xE7al\u0131\u015Ft\u0131."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Ama B\xF6r\xFChan'\u0131n \xDClgen Han'a sevgisi ve onunla edindi\u011Fi an\u0131lar, bu f\u0131s\u0131lt\u0131lar\u0131n \xFCstesinden geldi."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 1b85c12ef309323b2bffc83efae91dcb, type: 2}
    text: "Yalan s\xF6yl\xFCyorsunuz. Onu tan\u0131yorum."
    duration: 0
    setFlag: 
