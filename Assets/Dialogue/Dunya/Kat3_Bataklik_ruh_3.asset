  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: Kat3_Bataklik_ruh_3
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 11400000, guid: 230add4ab1e11c222994fbfce38d7ded, type: 2}
    text: "Ben bir \u015Famand\u0131m. \xC7al\u0131\u015F Han'a tapanlara kat\u0131ld\u0131m, salg\u0131n\u0131 kutsal sand\u0131m..."
    voice: {fileID: 8300000, guid: 484047874e08b5e7da5ba6bbf2901135, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 230add4ab1e11c222994fbfce38d7ded, type: 2}
    text: "Batakl\u0131\u011F\u0131n dibinden yeni yarat\u0131klar do\u011Fuyor. O onlar\u0131 \xE7a\u011F\u0131rd\u0131k\xE7a \xF6l\xFCler bile rahat edemiyor."
    voice: {fileID: 8300000, guid: c6848c839d4c91f6f8cb08bcbc0e537e, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 230add4ab1e11c222994fbfce38d7ded, type: 2}
    text: "Onu yenersen, zehrin sana dokunamaz olur. Bu batakl\u0131\u011F\u0131n tek iyili\u011Fi budur."
    voice: {fileID: 8300000, guid: 093f558800627fe498d14002149ab159, type: 3}
    duration: 0
    setFlag: 
