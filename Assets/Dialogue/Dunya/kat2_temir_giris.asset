  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: kat2_temir_giris
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Sona geldi\u011Finde, \xF6n\xFCnde kanlar\u0131nda lav akan, ta\u015Ftan bir dev belirdi. Elinde devasa bir metal balyoz vard\u0131."
    voice: {fileID: 8300000, guid: c4ea1e7379098b30cbd1bac67bd081cb, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: c9ef80fc917aff2cd8e488df92226c15, type: 2}
    text: "Erlik'in \xF6rs\xFCne bir demir daha... Gel, seni de d\xF6veyim!"
    voice: {fileID: 8300000, guid: e0d0da45a79fe1dfc8e4602c1ec9522d, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Temir Han yava\u015Ft\u0131 ama sert vuruyordu. Tek bir darbesi bile neredeyse \xF6l\xFCmc\xFCld\xFC."
    voice: {fileID: 8300000, guid: ffabdd79748ae318dbc865b1f7ea319c, type: 3}
    duration: 0
    setFlag: 
