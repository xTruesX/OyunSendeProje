  m_Name: Kat3_Bataklik_yazit_4
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "\"D\xF6rd\xFCnc\xFC kattan sekizinciye uzanan derinliklerde Buz Devi uyur, Kam-Su'nun k\u0131zg\u0131n bak\u0131r nehirleri akar ve Kut \xC7e\u015Fmesi kadim s\u0131rlar\u0131n\u0131 saklar.\""
    voice: {fileID: 8300000, guid: 5093ebcc35685301eaea1f456b2723ae, type: 3}
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "\"Ama Erlik'e giden en k\u0131sa yol, \xC7al\u0131\u015F Han'\u0131n \xE7ukurundan ge\xE7er.\""
    voice: {fileID: 8300000, guid: 08bb20c36379c1e72b1d766f94ae7e16, type: 3}
    duration: 0
    setFlag: 
