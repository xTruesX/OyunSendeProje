  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: 01_KilicSunagi
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Kumlar\u0131n aras\u0131na saplanm\u0131\u015F eski bir k\u0131l\u0131\xE7 duruyordu."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 1b85c12ef309323b2bffc83efae91dcb, type: 2}
    text: "Bu k\u0131l\u0131\xE7... Sanki beni bekliyordu."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan k\u0131l\u0131c\u0131 kavrad\u0131."
    duration: 0
    setFlag: kilic_alindi
  - speaker: {fileID: 0}
    text: "Hafif sald\u0131r\u0131: J / Sol T\u0131k \u2014 \xFC\xE7 vuru\u015Fluk kombo.  A\u011F\u0131r sald\u0131r\u0131: K / Sa\u011F T\u0131k."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Ka\xE7\u0131\u015F: Shift \u2014 sald\u0131r\u0131lar\u0131n i\xE7inden zarar g\xF6rmeden ge\xE7ersin."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Savu\u015Fturma: Q \u2014 vuru\u015Ftan hemen \xF6nce basarsan d\xFC\u015Fman\u0131n dengesi bozulur."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Dengesi bozulan d\xFC\u015Fmana a\u011F\u0131r sald\u0131r\u0131 yaparsan Kut Y\u0131k\u0131m\u0131 vurursun."
    duration: 0
    setFlag: 
