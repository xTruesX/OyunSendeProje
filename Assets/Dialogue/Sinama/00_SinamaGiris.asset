  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: 00_SinamaGiris
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Ma\u011Faraya giren B\xF6r\xFChan, kendini kristal kumlarla kapl\u0131 tuhaf bir yerde buldu."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Buras\u0131, yeralt\u0131n\u0131n ilk kat\u0131n\u0131n bir yans\u0131mas\u0131 gibiydi."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 84ebdd9607b946e368d16726ebe1701c, type: 2}
    text: "Gel... Gel ve kendini s\u0131na..."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "(Bu bir s\u0131nama alan\u0131d\u0131r. D\xFC\u015Fmanlar her giri\u015Fte yeniden belirir.)"
    duration: 0
    setFlag: 
