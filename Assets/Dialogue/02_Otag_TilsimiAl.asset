  m_Script: {fileID: 11500000, guid: e525b435dff6f3df5bb509836d41dbde, type: 3}
  m_Name: 02_Otag_TilsimiAl
  m_EditorClassIdentifier: Assembly-CSharp::Boruhan.Dialogue.DialogueAsset
  lines:
  - speaker: {fileID: 0}
    text: "Sand\u0131\u011F\u0131n i\xE7inde, \xDClgen Han'\u0131n ona b\u0131rakt\u0131\u011F\u0131 t\u0131ls\u0131m duruyordu."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "Bir anda \xDClgen Han'\u0131n s\xF6yledi\u011Fi bir s\xF6z akl\u0131na geldi."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 3e7b2198f83b50c2cba876a3a693f5ed, type: 2}
    text: "E\u011Fer bir g\xFCn \xE7aresiz hissedersen, o t\u0131ls\u0131m sana yol g\xF6sterecek."
    duration: 0
    setFlag: 
  - speaker: {fileID: 11400000, guid: 1b85c12ef309323b2bffc83efae91dcb, type: 2}
    text: "Yol g\xF6ster \xF6yleyse..."
    duration: 0
    setFlag: 
  - speaker: {fileID: 0}
    text: "B\xF6r\xFChan t\u0131ls\u0131m\u0131 ald\u0131 ve yolculu\u011Fa haz\u0131rland\u0131."
    duration: 0
    setFlag: tilsim_alindi
